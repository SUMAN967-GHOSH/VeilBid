generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuctionContract {
  id                 String    @id @default(uuid())
  contractAddress    String    @unique
  itemDescription    String
  deployerAddress    String?   // Wallet address of the seller (used for isSeller check)
  deployTxHash       String?   // Transaction hash of the deploy tx
  network            String    @default("preprod")
  auctionEndBlock    BigInt?
  reserveCommitment  String?
  lastKnownStatus    String    @default("OPEN")
  lastSyncedAt       DateTime?
  category           String?
  imageUrl           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
